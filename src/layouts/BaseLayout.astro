---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { titulo = "Setup Ideal | Reviews Transparentes" } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{titulo}</title>
    <!-- Mantemos o CDN do Phosphor para os ícones funcionarem -->
    <script src="https://unpkg.com/@phosphor-icons/web" is:inline></script>
</head>
<body class="font-sans text-slate-800 antialiased selection:bg-brand-500 selection:text-white">
    <Header />
    
    <!-- Onde o conteúdo específico de cada página vai aparecer -->
    <slot />

    <Footer />
</body>
</html>