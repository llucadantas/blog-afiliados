---
import BaseLayout from "./BaseLayout.astro";
// Removemos a TabelaPrecos antiga e vamos criar o widget direto aqui para o layout de Produto Único
const { frontmatter } = Astro.props;

// Função auxiliar para os ícones e cores do mini-widget lateral
const obterEstiloLoja = (nome: string) => {
    const n = nome.toLowerCase();
    if (n.includes("amazon"))
        return { cor: "text-amber-500", icone: "ph-amazon-logo" };
    if (n.includes("shopee"))
        return { cor: "text-orange-600", icone: "ph-shopping-bag" };
    if (n.includes("mercado livre") || n.includes("ml"))
        return { cor: "text-yellow-500", icone: "ph-handshake" };
    return { cor: "text-brand-500", icone: "ph-storefront" };
};
---

<BaseLayout titulo={`${frontmatter.titulo} | SetupIdeal`}>
    <div
        class="bg-slate-900 pt-36 pb-24 border-b border-slate-800 relative overflow-hidden"
    >
        <div
            class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5"
        >
        </div>
        <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 text-center">
            <div class="flex items-center justify-center gap-3 mb-6">
                <span
                    class="bg-brand-500/10 text-brand-400 border border-brand-500/20 font-semibold px-4 py-1 rounded-full text-xs uppercase tracking-widest backdrop-blur-sm"
                >
                    {frontmatter.categoria}
                </span>
                <span class="text-slate-400 text-xs font-medium tracking-wide">
                    <i class="ph ph-calendar-blank mr-1"></i>
                    {frontmatter.data}
                </span>
            </div>

            <h1
                class="text-3xl sm:text-5xl font-display font-black text-white leading-tight mb-6 tracking-tight max-w-3xl mx-auto"
            >
                {frontmatter.titulo}
            </h1>

            <p
                class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto mb-8 font-normal leading-relaxed"
            >
                {frontmatter.resumo}
            </p>

            <div
                class="inline-flex items-center gap-3 bg-slate-800/40 border border-slate-700/50 px-4 py-2 rounded-2xl backdrop-blur-sm"
            >
                <img
                    src="https://api.dicebear.com/7.x/notionists/svg?seed=Felix&backgroundColor=f43f5e"
                    class="w-8 h-8 rounded-full border border-brand-500/30"
                    alt="Autor"
                />
                <div class="text-left">
                    <p class="text-slate-200 text-xs font-bold">
                        Por Lucas Dantas
                    </p>
                    <p class="text-[10px] text-slate-500">
                        Especialista em Hardware
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col lg:flex-row gap-12 relative z-20"
    >
        <main class="lg:w-2/3 -mt-16 md:-mt-20 pb-20">
            <div
                class="relative rounded-[2rem] overflow-hidden shadow-2xl border-4 border-white mb-10 bg-slate-100 aspect-video md:h-[420px] w-full"
            >
                <img
                    src={frontmatter.imagem}
                    alt={frontmatter.titulo}
                    class="w-full h-full object-cover"
                />
                {
                    frontmatter.nota && (
                        <div class="absolute bottom-6 left-6 bg-slate-900/90 backdrop-blur-md text-white rounded-2xl p-3 flex items-center gap-3 shadow-xl border border-white/10">
                            <div class="w-10 h-10 bg-brand-500 rounded-xl flex items-center justify-center text-white font-display font-black text-lg shadow-md shadow-brand-500/20">
                                {frontmatter.nota}
                            </div>
                            <div>
                                <div class="flex text-brand-400 text-xs">
                                    <>
                                        <i class="ph-fill ph-star" />
                                        <i class="ph-fill ph-star" />
                                        <i class="ph-fill ph-star" />
                                        <i class="ph-fill ph-star" />
                                        <i class="ph-fill ph-star" />
                                    </>
                                </div>
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">
                                    Veredito SetupIdeal
                                </p>
                            </div>
                        </div>
                    )
                }
            </div>

            <div
                class="bg-gradient-to-r from-brand-50/60 to-rose-50/20 border border-brand-100 rounded-3xl p-6 sm:p-8 mb-10 flex flex-col sm:flex-row items-center gap-6 shadow-sm relative overflow-hidden"
            >
                <div
                    class="absolute -right-8 -bottom-8 w-32 h-32 bg-brand-500/5 rounded-full blur-2xl"
                >
                </div>
                <div class="flex-1 text-center sm:text-left relative z-10">
                    <span
                        class="text-[10px] bg-brand-500 text-white font-bold px-2 py-0.5 rounded-md uppercase tracking-wider mb-2 inline-block"
                        >Direto ao Ponto</span
                    >
                    <h3
                        class="font-display font-bold text-slate-900 text-xl mb-1"
                    >
                        Decidido a comprar?
                    </h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Garante o menor preço verificado de hoje através do
                        nosso link afiliado seguro.
                    </p>
                </div>
                <a
                    href={frontmatter.link_afiliado}
                    target="_blank"
                    class="w-full sm:w-auto px-8 py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold text-sm rounded-2xl shadow-lg shadow-brand-500/20 transition-all flex items-center justify-center gap-2 whitespace-nowrap group relative z-10"
                >
                    <i
                        class="ph-bold ph-shopping-cart text-lg group-hover:scale-110 transition-transform"
                    ></i> Conferir Preço Oficial
                </a>
            </div>

            <article
                class="prose prose-slate sm:prose-lg max-w-none
    prose-headings:font-display prose-headings:font-black prose-headings:tracking-tight prose-headings:text-slate-900
    prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b-2 prose-h2:border-slate-100
    prose-h3:text-xl prose-h3:text-brand-600
    prose-p:text-slate-700 prose-p:leading-loose prose-p:mb-6
    prose-a:text-brand-500 prose-a:font-bold prose-a:decoration-brand-500/30 hover:prose-a:decoration-brand-500 transition-all
    prose-strong:text-slate-900 prose-strong:font-extrabold prose-strong:bg-brand-50/50 prose-strong:px-1
    prose-ul:space-y-3 prose-li:text-slate-700 prose-li:marker:text-brand-500
    prose-blockquote:border-l-4 prose-blockquote:border-brand-500 prose-blockquote:bg-slate-50 prose-blockquote:py-2 prose-blockquote:px-6 prose-blockquote:rounded-r-2xl prose-blockquote:font-medium prose-blockquote:text-slate-800 prose-blockquote:not-italic
    prose-img:rounded-[2rem] prose-img:shadow-xl prose-img:border prose-img:border-slate-200/60 prose-img:my-10"
            >
                <slot />
            </article>
        </main>

        <aside class="lg:w-1/3 lg:mt-6 pb-12">
            <div class="sticky top-24 space-y-8">
                {
                    frontmatter.precos_lojas && (
                        <div class="bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-200/50 overflow-hidden">
                            <div class="bg-slate-50 px-5 py-4 border-b border-slate-200 flex items-center gap-2">
                                <i class="ph-bold ph-tag text-brand-500 text-xl" />
                                <h3 class="font-display font-bold text-slate-900 text-sm uppercase tracking-widest m-0!">
                                    Onde Comprar Barato
                                </h3>
                            </div>

                            <div class="p-3 space-y-2">
                                {frontmatter.precos_lojas.map((loja: any) => {
                                    const estilos = obterEstiloLoja(loja.nome);
                                    return (
                                        <a
                                            href={loja.link}
                                            target="_blank"
                                            class="flex flex-col p-4 rounded-2xl border border-slate-100 hover:border-brand-200 hover:bg-brand-50/30 transition-all group"
                                        >
                                            <div class="flex items-center justify-between mb-2">
                                                <div class="flex items-center gap-2">
                                                    <i
                                                        class={`ph-fill ${estilos.icone} text-lg ${estilos.cor}`}
                                                    />
                                                    <span class="font-bold text-slate-700 text-sm">
                                                        {loja.nome}
                                                    </span>
                                                </div>
                                                {loja.badge && (
                                                    <span class="text-[9px] bg-brand-100 text-brand-700 font-bold px-1.5 py-0.5 rounded uppercase tracking-wide">
                                                        {loja.badge}
                                                    </span>
                                                )}
                                            </div>
                                            <div class="flex items-end justify-between">
                                                <span class="font-display font-black text-xl text-slate-900 group-hover:text-brand-600 transition-colors">
                                                    {loja.preco}
                                                </span>
                                                <div class="w-8 h-8 rounded-full bg-slate-100 group-hover:bg-brand-500 flex items-center justify-center transition-colors">
                                                    <i class="ph-bold ph-arrow-up-right text-slate-400 group-hover:text-white text-sm" />
                                                </div>
                                            </div>
                                        </a>
                                    );
                                })}
                            </div>
                        </div>
                    )
                }

                <div
                    class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm relative overflow-hidden group hidden lg:block"
                >
                    <div
                        class="absolute top-0 left-0 w-1.5 h-full bg-slate-300"
                    >
                    </div>
                    <h3
                        class="font-display font-bold text-slate-900 mb-3 flex items-center gap-2"
                    >
                        <i class="ph-fill ph-info text-slate-400 text-xl"></i> Apoie
                        o Site
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        Ao comprar através dos links acima, nós podemos ganhar
                        uma pequena comissão das lojas. Isso não altera o valor
                        final do produto para você e ajuda a manter o nosso
                        trabalho independente.
                    </p>
                </div>
            </div>
        </aside>
    </div>
</BaseLayout>
