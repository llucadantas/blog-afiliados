---
import BaseLayout from './BaseLayout.astro';

// O Astro injeta automaticamente os dados do cabeçalho do Markdown na variável frontmatter
const { frontmatter } = Astro.props;
---

<BaseLayout titulo={`${frontmatter.titulo} | SetupIdeal`}>
    
    <div class="bg-dark-900 pt-32 pb-16 border-b border-dark-800">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
            <div class="flex items-center justify-center gap-3 mb-6">
                <span class="bg-brand-500/20 text-brand-400 border border-brand-500/30 font-bold px-3 py-1 rounded-full text-xs uppercase tracking-wider">
                    {frontmatter.categoria}
                </span>
                <span class="text-slate-400 text-sm font-medium">{frontmatter.data}</span>
            </div>
            
            <h1 class="text-3xl sm:text-5xl font-display font-bold text-white leading-tight mb-6">
                {frontmatter.titulo}
            </h1>
            
            <p class="text-lg text-slate-400 max-w-2xl mx-auto mb-8 line-clamp-2">
                {frontmatter.resumo}
            </p>
            
            <div class="flex items-center justify-center gap-3">
                <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Felix&backgroundColor=f43f5e" class="w-10 h-10 rounded-full border-2 border-dark-700" alt="Autor">
                <div class="text-left">
                    <p class="text-white text-sm font-bold">Por Lucas</p>
                    <p class="text-slate-500 text-xs">Especialista em Setup</p>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex flex-col lg:flex-row gap-12">
        
        <main class="lg:w-2/3">
            <img src={frontmatter.imagem} alt={frontmatter.titulo} class="w-full h-auto md:h-[400px] object-cover rounded-3xl shadow-lg mb-10 -mt-24 relative z-10 border-4 border-white">
            
            <div class="bg-brand-50 border border-brand-100 rounded-2xl p-5 sm:p-8 mb-10 flex flex-col sm:flex-row items-center gap-6 shadow-sm">
                <div class="flex-1 text-center sm:text-left">
                    <h3 class="font-bold text-slate-900 text-lg mb-1">Decidido a comprar?</h3>
                    <p class="text-slate-600 text-sm">Verifique o menor preço disponível hoje com nosso link seguro.</p>
                </div>
                <a href={frontmatter.link_afiliado} target="_blank" class="w-full sm:w-auto px-8 py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl shadow-lg shadow-brand-500/30 transition-all flex items-center justify-center gap-2 whitespace-nowrap">
                    <i class="ph-bold ph-shopping-cart text-xl"></i> Conferir Preço
                </a>
            </div>

            <article class="prose prose-slate prose-lg max-w-none prose-headings:font-display prose-headings:font-bold prose-a:text-brand-500 hover:prose-a:text-brand-600 prose-img:rounded-2xl prose-strong:text-slate-900">
                <slot /> 
            </article>

            <div class="mt-12 p-8 bg-slate-900 rounded-3xl text-center shadow-xl border border-slate-800">
                <h3 class="text-white font-display font-bold text-2xl mb-3">Gostou do {frontmatter.titulo}?</h3>
                <p class="text-slate-400 mb-6 max-w-md mx-auto">Apoie o nosso trabalho comprando através do link abaixo. Você não paga nada a mais por isso!</p>
                <a href={frontmatter.link_afiliado} target="_blank" class="inline-flex px-8 py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl shadow-lg shadow-brand-500/30 transition-all items-center gap-2">
                    <i class="ph-bold ph-arrow-up-right text-xl"></i> Comprar Agora
                </a>
            </div>
        </main>

        <aside class="lg:w-1/3 space-y-8">
            <div class="bg-slate-50 rounded-3xl p-6 border border-slate-200">
                <h3 class="font-display font-bold text-lg text-slate-900 mb-3 flex items-center gap-2">
                    <i class="ph-fill ph-seal-check text-brand-500 text-xl"></i> Review Independente
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                    Nenhuma marca patrocinou este artigo. As opiniões aqui refletem nossos próprios testes diários de uso.
                </p>
            </div>

            <div class="bg-dark-900 rounded-3xl p-6 shadow-xl relative overflow-hidden border border-dark-800">
                <h3 class="font-display font-bold text-lg text-white flex items-center gap-2 mb-4">
                    <i class="ph-fill ph-plus-circle text-brand-500"></i> Compre Junto
                </h3>
                <div class="bg-white/10 p-3 rounded-2xl flex gap-4 items-center mb-4">
                    <img src="https://images.unsplash.com/photo-1618366712010-f4ae9c647dcb?q=80&w=150&auto=format&fit=crop" class="w-16 h-16 object-cover rounded-xl shadow-md" alt="Acessório">
                    <div>
                        <h4 class="text-white text-sm font-bold leading-tight">Apoio de Pulso Ergonômico</h4>
                        <span class="text-brand-400 text-xs font-bold mt-1 block">Mais vendido</span>
                    </div>
                </div>
                <a href="#" class="w-full py-3 bg-white text-slate-900 hover:bg-slate-200 text-sm font-bold text-center rounded-xl transition-all shadow-md block">
                    Ver Acessório
                </a>
            </div>
        </aside>
    </div>
</BaseLayout>