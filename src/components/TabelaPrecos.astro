---
interface LojaPreco {
  nome: string;
  preco: string;
  link: string;
  badge?: string; // Ex: "Melhor Preço", "Frete Grátis"
}

interface Props {
  lojas: LojaPreco[];
}

const { lojas } = Astro.props;

// Função auxiliar para definir os logos ou cores com base no nome da loja
const obterCorLoja = (nome: string) => {
  const n = nome.toLowerCase();
  if (n.includes('amazon')) return 'text-amber-500';
  if (n.includes('shopee')) return 'text-orange-600';
  if (n.includes('mercado livre') || n.includes('ml')) return 'text-yellow-500';
  return 'text-brand-500';
};
---

<div class="my-10 bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="bg-slate-50 px-6 py-4 border-b border-slate-200 flex items-center justify-between">
    <h3 class="font-display font-bold text-slate-900 text-base flex items-center gap-2 m-0! md:text-lg">
      <i class="ph-bold ph-trend-down text-emerald-500"></i> Compare Preços e Economize
    </h3>
    <span class="text-[10px] bg-emerald-500/10 text-emerald-600 font-bold px-2.5 py-1 rounded-md uppercase tracking-wider hidden sm:inline-block">
      Atualizado Hoje
    </span>
  </div>

  <div class="divide-y divide-slate-100">
    {lojas.map((loja) => (
      <div class="px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/50 transition-colors">
        
        <div class="flex items-center gap-3">
          <i class={`ph-fill ph-storefront text-2xl ${obterCorLoja(loja.nome)}`}></i>
          <div>
            <p class="font-bold text-slate-900 text-sm m-0!">{loja.nome}</p>
            {loja.badge && (
              <span class="inline-block text-[9px] bg-brand-50 text-brand-600 font-extrabold px-1.5 py-0.5 rounded uppercase tracking-wide mt-0.5 border border-brand-100">
                {loja.badge}
              </span>
            )}
          </div>
        </div>

        <div class="flex items-center justify-between sm:justify-end gap-6 border-t border-slate-100 pt-3 sm:border-0 sm:pt-0">
          <div class="sm:text-right">
            <span class="text-[10px] text-slate-400 block uppercase font-medium tracking-wide">A partir de</span>
            <span class="font-display font-black text-slate-950 text-lg sm:text-xl">{loja.preco}</span>
          </div>
          
          <a 
            href={loja.link} 
            target="_blank" 
            class="px-5 py-2.5 bg-slate-900 hover:bg-brand-500 text-white text-xs font-bold rounded-xl transition-all shadow-sm flex items-center gap-1.5 group"
          >
            Ir para a loja 
            <i class="ph-bold ph-arrow-up-right text-xs opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"></i>
          </a>
        </div>

      </div>
    ))}
  </div>
</div>