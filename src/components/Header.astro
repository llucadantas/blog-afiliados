---
---
<nav class="fixed w-full z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm" id="navbar">
    <div class="bg-slate-900 text-slate-300 text-xs py-1.5 text-center font-medium">
        <span class="flex items-center justify-center gap-2">
            <i class="ph-fill ph-shield-check text-brand-500 text-sm"></i> 
            Análises independentes. Se você comprar por nossos links, podemos ganhar uma comissão.
        </span>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20 gap-6">
            <a href="/" class="flex-shrink-0 flex items-center gap-2 cursor-pointer">
                <div class="w-10 h-10 bg-brand-500 rounded-xl flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
                    <i class="ph-bold ph-crosshair text-2xl"></i>
                </div>
                <span class="font-display font-bold text-2xl tracking-tight text-slate-900 hidden sm:block">Setup<span class="text-brand-500">Ideal</span></span>
            </a>

            <div class="flex-1 max-w-2xl relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <i class="ph ph-magnifying-glass text-slate-400 group-focus-within:text-brand-500 transition-colors text-lg"></i>
                </div>
                <input type="text" class="block w-full pl-11 pr-4 py-3 bg-slate-100 border-transparent rounded-2xl text-sm placeholder-slate-500 focus:border-brand-500 focus:bg-white focus:ring-4 focus:ring-brand-500/10 transition-all outline-none text-slate-900" placeholder="Pesquisar teclados, monitores, fones...">
                <button class="absolute inset-y-1.5 right-1.5 bg-slate-900 hover:bg-brand-500 text-white text-xs font-bold px-4 rounded-xl transition-colors hidden sm:block">Buscar</button>
            </div>

            <div class="md:hidden flex items-center">
                <button class="text-slate-600 hover:text-brand-500"><i class="ph ph-list text-3xl"></i></button>
            </div>
        </div>
    </div>
</nav>