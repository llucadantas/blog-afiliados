---
const { post } = Astro.props;
---

<div class="pt-36 pb-10 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <a
            href={post.linkReview}
            class="block relative rounded-[2rem] overflow-hidden bg-dark-900 flex flex-col lg:flex-row group cursor-pointer shadow-2xl border border-slate-200"
        >
            <div class="lg:w-3/5 relative h-72 lg:h-auto overflow-hidden">
                <div
                    class="absolute inset-y-0 right-0 w-16 bg-gradient-to-r from-transparent to-dark-900 z-10 hidden lg:block"
                >
                </div>

                <img
                    src={post.imagem}
                    alt={post.titulo}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute top-6 left-6 z-20 flex gap-2">
                    <span
                        class="bg-brand-500 text-white text-[10px] sm:text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider flex items-center gap-1 shadow-lg shadow-brand-500/30"
                    >
                        <i class="ph-fill ph-star"></i> Review em Destaque
                    </span>
                </div>
            </div>

            <div
                class="lg:w-2/5 p-8 lg:p-12 relative z-20 flex flex-col justify-center bg-dark-900 border-l border-white/5"
            >
                <div
                    class="flex items-center gap-3 text-slate-400 text-sm mb-4"
                >
                    <span
                        class="font-medium text-brand-400 bg-brand-500/10 px-2.5 py-1 rounded-md"
                        >{post.categoria}</span
                    >
                    <span>&bull;</span>
                    <span>{post.data}</span>
                </div>

                <h1
                    class="text-3xl lg:text-4xl font-display font-bold text-white mb-4 leading-tight group-hover:text-brand-400 transition-colors"
                >
                    {post.titulo}
                </h1>

                <p class="text-slate-300 mb-8 line-clamp-3 text-base">
                    {post.resumo}
                </p>

                <div class="flex items-center justify-between mt-auto">
                    <div class="flex items-center gap-3">
                        <img
                            src="https://api.dicebear.com/7.x/notionists/svg?seed=Felix&backgroundColor=f43f5e"
                            class="w-10 h-10 rounded-full border-2 border-brand-500"
                            alt="Autor"
                        />
                        <div>
                            <p class="text-white text-sm font-bold">
                                Lucas Dev
                            </p>
                            <p class="text-slate-400 text-xs">
                                Especialista em Hardware
                            </p>
                        </div>
                    </div>
                    <div
                        class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-brand-500 transition-colors"
                    >
                        <i class="ph-bold ph-arrow-right text-white"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>
